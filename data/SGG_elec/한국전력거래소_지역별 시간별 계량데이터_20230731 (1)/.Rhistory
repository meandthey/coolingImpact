library(tidyverse)
library(lubridate)
# 데이터 폴더 경로 설정
data_folder <- "."  # 예: "./data/"
# 측정 요소 매핑 (열 이름 → 파일명 접미어)
elements <- list(
"기온(°C)" = "기온",
"강수량(mm)" = "강수",
"풍속(m/s)" = "풍속",
"습도(%)" = "습도",
"일사(MJ/m2)" = "일사",
"적설(cm)" = '적설'
)
# 연도 반복
for (year in 2013:2024) {
file_path <- paste0(data_folder, year, ".csv")
if (!file.exists(file_path)) next
df <- read_csv(file_path, locale = locale(encoding = "UTF-8")) %>%
mutate(일시 = ymd_hms(일시))  # 문자열을 날짜형으로 변환
지점들 <- unique(df$지점명)
for (지점 in 지점들) {
df_sub <- df %>% filter(지점명 == 지점)
for (colname in names(elements)) {
if (!colname %in% colnames(df_sub)) next
ggplot(df_sub, aes(x = 일시, y = .data[[colname]])) +
geom_line(color = "steelblue") +
labs(
title = paste0(지점, " - ", year, "년 ", elements[[colname]], " 시계열"),
x = "시간", y = elements[[colname]]
) +
theme_minimal() -> p
# 저장 파일명 예: "속초_2013_강수.png"
file_out <- paste0(지점, "_", year, "_", elements[[colname]], ".png")
ggsave(filename = file_out, plot = p, width = 10, height = 4)
}
}
}
