library(tidyverse)
library(lubridate)
library(stringr)
# 데이터 폴더 경로 설정
data_folder <- "./"  # 예: "./data/"
# 측정 요소 매핑 (열 이름 → 파일명 접미어)
elements <- list(
"기온(°C)" = "기온",
"강수량(mm)" = "강수",
"풍속(m/s)" = "풍속",
"습도(%)" = "습도",
"일사(MJ/m2)" = "일사",
"적설(cm)" = "적설"
)
# 24:00:00 문자열을 00:00:00 + 하루로 보정하는 함수
fix_24h <- function(time_str) {
is_24 <- str_detect(time_str, " 24:00:00")
time_fixed <- ifelse(
is_24,
format(ymd_hms(str_replace(time_str, " 24:00:00", " 00:00:00")) + hours(24), "%Y-%m-%d %H:%M:%S"),
time_str
)
return(time_fixed)
}
year = 2024
file_path <- paste0(data_folder, year, ".csv")
file_path
# 파일 읽기 + 일시 보정
df <- read_csv(file_path, locale = locale(encoding = "EUC-KR")) %>%
mutate(
일시 = fix_24h(as.character(일시)),
일시 = ymd_hms(일시)
)
df
read_csv(file_path, locale = locale(encoding = "EUC-KR"))
View(read_csv(file_path, locale = locale(encoding = "EUC-KR")))
