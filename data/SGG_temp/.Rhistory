# 예시: 2004년 1월부터 2024년 12월까지의 유효일수 계산
dates <- seq.Date(as.Date("2004-01-01"), as.Date("2024-12-31"), by = "day")
calendar <- tibble(
date = dates,
year = year(dates),
month = month(dates),
wday = wday(dates, label = TRUE),
holiday = isHoliday(as.timeDate(dates), "KR")  # 한국 공휴일
)
