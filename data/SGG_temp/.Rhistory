# 예시: 2010년 1월부터 2020년 12월까지의 유효일수 계산
dates <- seq.Date(as.Date("2010-01-01"), as.Date("2020-12-31"), by = "day")
calendar <- tibble(
date = dates,
year = year(dates),
month = month(dates),
wday = wday(dates, label = TRUE),
holiday = isHoliday(as.timeDate(dates), "KR")  # 한국 공휴일
)
# 유효일 가중치 예시 (일반용)
calendar <- calendar %>%
mutate(weight = case_when(
holiday ~ 0.84,
wday %in% c("Sat") ~ 0.93,
wday %in% c("Sun") ~ 0.84,
TRUE ~ 1.00
))
med_monthly <- calendar %>%
group_by(year, month) %>%
summarise(MED = sum(weight), .groups = "drop")
med_monthly
