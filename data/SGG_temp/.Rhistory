mutate(model_id = region_type) %>%
rowwise() %>%
mutate(
s = list(s_grid),
f_s = list(x1 * s_grid + x2 * s_grid^2 + x3 * cos(2 * pi * s_grid) + x4 * sin(2 * pi * s_grid))
) %>%
unnest(c(s, f_s))
ggplot(response_curve_df, aes(x = s, y = f_s, group = model_id)) +
geom_line(alpha = 0.6) +
labs(
title = "지역별 기온 반응함수 (f(s) = β₁s + β₂s² + β₃cos(2πs) + β₄sin(2πs))",
x = "표준화 기온 s ∈ [0,1]",
y = "반응함수 f(s)"
) +
theme_minimal()
