# 1. id별 그룹화 후 회귀 실행
models_split_TE <- allData %>%
group_by(id) %>%
group_split() %>%
set_names(map_chr(., ~ unique(.x$id))) %>%
map(~ lm(log_demand_per_day ~ log(grdp_month) + log(real_powerCPI) + TE_cooling + TE_heating, data = .x))
# 2. 결과 요약
