# 전제: s_grid는 0~1 사이 등간격 벡터, 예: s_grid <- seq(0, 1, length.out = 200)
ds <- diff(s_grid)[1]
calculate_TE_components <- function(model, kde, id_label) {
# 회귀계수 추출
b <- coef(model)[c("x1", "x2", "x3", "x4")]
if (length(b) != 4 || any(is.na(b))) return(NULL)
# 기온 반응함수: k(s)
k_s <- b[1]*s_grid + b[2]*s_grid^2 + b[3]*cos(2*pi*s_grid) + b[4]*sin(2*pi*s_grid)
# 최적기온 위치: s*
s_star <- s_grid[which.min(k_s)]
k_star <- min(k_s)
# 커널 밀도 추정치: f(s)
f_hat <- approx(kde$x, kde$y, xout = s_grid, rule = 2)$y
# TE_cooling: s > s*
TE_c <- sum(((k_s - k_star) * f_hat)[s_grid > s_star]) * ds
# TE_heating: s < s*
TE_h <- sum(((k_s - k_star) * f_hat)[s_grid < s_star]) * ds
# baseline
baseline <- k_star
# 총 TE = cooling + heating + baseline
TE_total <- TE_c + TE_h + baseline
# 결과 tibble로 반환
tibble(
id = id_label,
s_star = s_star,
T_star = s_star * 60 - 20,
TE_total = TE_total,
TE_cooling = TE_c,
TE_heating = TE_h,
baseline = baseline
)
}
# 전체 계산
te_components_df <- map2_dfr(
names(region_type_models_filtered),
region_type_models_filtered,
function(id, model) {
if (!id %in% names(kernel_by_jym)) return(NULL)
kde <- kernel_by_jym[[id]]
calculate_TE_components(model, kde, id)
}
)
te_components_df
region_type_models_filtered
